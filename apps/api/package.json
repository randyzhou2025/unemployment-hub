{
  "name": "@uh/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "node build.mjs",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file=.env src/db/seed.ts"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "@fastify/cookie": "11.1.3",
    "@fastify/rate-limit": "10.3.0",
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.7",
    "zod": "3.24.2",
    "marked": "15.0.12",
    "@uh/contracts": "workspace:*",
    "@uh/domain": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
